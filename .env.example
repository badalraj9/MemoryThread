# Memory Thread Configuration
# Copy this to .env and modify as needed

# =============================================================================
# PRIMARY CONNECTION - MT_URL (Recommended)
# =============================================================================
# Format: mt://host:port/namespace?api_key=xxx
# Examples:
#   - mt://localhost:8000/default        (local server, default namespace)
#   - mt://localhost:8000/my-project    (local server, custom namespace)
#   - mt://api.memorythread.io/my-org/project?api_key=sk-xxx  (cloud)
MT_URL=mt://localhost:8000/default

# =============================================================================
# API KEY (optional, for cloud servers that require authentication)
# =============================================================================
# Can also be passed in MT_URL query string: mt://host/namespace?api_key=xxx
# MT_API_KEY=sk-your-api-key-here

# =============================================================================
# DATABASE (Legacy/Fallback - used only if MT_URL not set)
# =============================================================================
# These are parsed from MT_URL automatically. Only set them separately
# if you need to connect to different services than specified in MT_URL.

# PostgreSQL (if not using MT_URL to infer)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=memory_thread_db
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your_password

# Qdrant Vector DB (if not using MT_URL to infer)
# QDRANT_HOST=localhost
# QDRANT_PORT=6333

# =============================================================================
# EMBEDDINGS
# =============================================================================
# Dimension of embedding vectors (default: 384 for MiniLM, 1536 for OpenAI)
EMBEDDING_DIMENSION=384
EMBEDDING_DISTANCE=Cosine

# =============================================================================
# TMS CONFIGURATION
# =============================================================================
# Truth Vector weights (adjust for your use case)
TRUTH_WEIGHT_CONFIDENCE=0.35
TRUTH_WEIGHT_AUTHORITY=0.30
TRUTH_WEIGHT_FRESHNESS=0.25
TRUTH_WEIGHT_CORROBORATION=0.10

# Decay rate (how fast memories fade)
DECAY_RATE_DEFAULT=0.01

# =============================================================================
# API SERVER
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO

# =============================================================================
# LLM PROVIDERS (for chat functionality)
# =============================================================================
# Groq: Fast inference, free tier
# Get key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter: Access to many models
# Get key at: https://openrouter.ai/keys
# Models: https://openrouter.ai/models
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=xiaomi/mimo-v2-flash:free
